# Extract qml-box2d sources into the 'external' subdirectory.
# avoiding another package to be created:
tar -C external -xf $CWD/src/applications-extra/qml-box2d-*.tar.xz
mv external/qml-box2d-*/* external/qml-box2d/
rm -rf external/qml-box2d-*/

chown -R root:root external/qml-box2d
find external/qml-box2d \
  \( -perm 777 -o -perm 775 -o -perm 711 -o -perm 555 -o -perm 511 \) \
  -exec chmod 755 {} \+ -o \
  \( -perm 666 -o -perm 664 -o -perm 600 -o -perm 444 -o -perm 440 -o -perm 400 \) \
  -exec chmod 644 {} \+

