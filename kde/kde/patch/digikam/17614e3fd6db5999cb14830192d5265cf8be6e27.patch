From 17614e3fd6db5999cb14830192d5265cf8be6e27 Mon Sep 17 00:00:00 2001
From: Gilles Caulier <caulier.gilles@gmail.com>
Date: Thu, 17 Sep 2026 07:56:25 +0200
Subject: [PATCH] fix deprecated warnings from Opencv 4.13 and later

---
 .../pipelines/facepipelinebase.cpp            | 19 ++++++++++++-------
 1 file changed, 12 insertions(+), 7 deletions(-)

diff --git a/core/utilities/facemanagement/pipelines/facepipelinebase.cpp b/core/utilities/facemanagement/pipelines/facepipelinebase.cpp
index b0054e3aff..1ae1dc1a9b 100644
--- a/core/utilities/facemanagement/pipelines/facepipelinebase.cpp
+++ b/core/utilities/facemanagement/pipelines/facepipelinebase.cpp
@@ -72,17 +72,22 @@ double FacePipelineBase::detectNoise1(const cv::Mat& cvGrayImage) const
 
 double FacePipelineBase::detectNoise2(const cv::Mat& cvGrayImage) const
 {
-    int H        = cvGrayImage.rows;
-    int W        = cvGrayImage.cols;
-    cv::Mat M    = (cv::Mat_<double>(3, 3) <<  1, -2,  1,
-                                              -2,  4, -2,
-                                               1, -2,  1);
+    int H               = cvGrayImage.rows;
+    int W               = cvGrayImage.cols;
+
+    double kernelData[] = {
+                             1, -2,  1,
+                            -2,  4, -2,
+                             1, -2,  1
+                          };
+
+    cv::Mat M(3, 3, CV_64F, kernelData);
 
     cv::Mat convolved;
     cv::filter2D(cvGrayImage, convolved, CV_64F, M);
 
-    double sigma = cv::sum(cv::abs(convolved))[0];
-    sigma        = sigma * std::sqrt(0.5 * M_PI) / (6 * (W - 2) * (H - 2));
+    double sigma        = cv::sum(cv::abs(convolved))[0];
+    sigma               = sigma * std::sqrt(0.5 * M_PI) / (6 * (W - 2) * (H - 2));
 
     return sigma;
 }
