for program in curl rsync; do
  if ! command -v >/dev/null 2>&1; then
    printf "Missing necessary program: '%s'\n" "$program"
    exit 1
  fi
done

last_update_file="/tmp/last_update_file.txt"
last_update=""
latest_update="$(curl -r 0-28 -L 'http://ftp.slackware.com/pub/slackware/slackware64-current/ChangeLog.txt')"

if [ -f "$last_update_file" ]; then
  last_update="$(cat -- "$last_update_file")"
else
  printf "%s" "$latest_update" >"$last_update_file"
fi

if [ "$last_update" != "$latest_update" ]; then
  printf "Last update differs from latest update. Updating '%s'." "$last_update_file"
  printf "%s" "$latest_update" >"$last_update_file"

  rsync \
    -avzu \
    --exclude='*.tar.?z*' \
    --exclude='*.tar.zst' \
    --exclude='*.zip' \
    'rsync://ftp.slackware.com/slackware/slackware64-current/source/' \
    "$(pwd -P)" &&

  git commit -a -m "$last_update"
fi
