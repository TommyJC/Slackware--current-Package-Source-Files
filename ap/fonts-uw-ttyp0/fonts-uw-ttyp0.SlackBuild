#  SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED TO,
#  PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR PROFITS;
#  OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY,
#  WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR
#  OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF
#  ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.

cd $(dirname $0) ; CWD=$(pwd)

PKGNAM=fonts-uw-ttyp0
SRCNAM=uw-ttyp0
VERSION=${VERSION:-$(echo $SRCNAM-*.tar.?z | rev | cut -f 3- -d . | cut -f 1 -d - | rev)}
ARCH=${ARCH:-noarch}
BUILD=${BUILD:-2}

# If the variable PRINT_PACKAGE_NAME is set, then this script will report what
# the name of the created package would be, and then exit. This information
# could be useful to other scripts.
if [ ! -z "${PRINT_PACKAGE_NAME}" ]; then
  echo "$PKGNAM-$VERSION-$ARCH-$BUILD.txz"
  exit 0
fi

NUMJOBS=${NUMJOBS:-" -j $(expr $(nproc) + 1) "}

# Fail on undeclared variables and broken pipes:
set -u -o pipefail

TMP=${TMP:-/tmp}
PKG=$TMP/package-$PKGNAM

rm -rf $PKG
mkdir -p $TMP $PKG

cd $TMP
rm -rf $SRCNAM-$VERSION
tar xvf $CWD/$SRCNAM-$VERSION.tar.?z || exit 1
cd $SRCNAM-$VERSION || exit 1

chown -R root:root .
find . \
  \( -perm 777 -o -perm 775 -o -perm 711 -o -perm 555 -o -perm 511 \) \
  -exec chmod 755 {} \+ -o \
  \( -perm 666 -o -perm 664 -o -perm 600 -o -perm 444 -o -perm 440 -o -perm 400 \) \
  -exec chmod 644 {} \+

# Generate the X11 and Linux console font formats.  The source defaults to
# PCF and OTB only, so enable the Linux console target for this package.
sed -i 's/^GEN_CONS_LINUX[[:space:]]*=[[:space:]]*0/GEN_CONS_LINUX = 1/' \
  TARGETS.dat

# Select the dotted zero variant; replace Digit0Dotted to choose another one.
sed -i 's/^#COPYTO Digit0Dotted Digit0$/COPYTO Digit0Dotted Digit0/' \
  VARIANTS.dat

./configure \
  --prefix=/usr \
  --pcfdir=/usr/share/fonts/misc \
  --otbdir=/usr/share/fonts/misc \
  --conslinuxdir=/usr/share/kbd/consolefonts \
  --bindir=/usr/bin \
  --mandir=/usr/man \
  --docdir=/usr/doc/$PKGNAM-$VERSION || exit 1

make $NUMJOBS || exit 1
make install install-util install-doc DESTDIR=$PKG || exit 1

# Font indexes are generated by doinst.sh after installation.
rm -f \
  $PKG/usr/share/fonts/misc/fonts.dir \
  $PKG/usr/share/fonts/misc/fonts.scale

# Compress manual pages:
find $PKG/usr/man -type f -exec gzip -9 {} \+
for i in $( find $PKG/usr/man -type l ) ; do
  ln -s $( readlink $i ).gz $i.gz
  rm $i
done

# Add a documentation directory:
mkdir -p $PKG/usr/doc/${PKGNAM}-$VERSION
cp -a \
  CHANGELOG INSTALL LICENSE README* TARGETS.dat TARGETS_BDF.dat \
  TARGETS_CONS_FREEBSD_SC.dat TARGETS_CONS_FREEBSD_VT.dat \
  TARGETS_CONS_LINUX.dat TARGETS_CONS_NETBSD.dat TARGETS_CONS_OPENBSD.dat \
  TARGETS_OTB.dat TARGETS_PCF.dat VARIANTS.dat \
  $PKG/usr/doc/${PKGNAM}-$VERSION

mkdir -p $PKG/install
cat $CWD/doinst.sh > $PKG/install/doinst.sh
cat $CWD/slack-desc > $PKG/install/slack-desc

cd $PKG
/sbin/makepkg -l y -c n $TMP/$PKGNAM-$VERSION-$ARCH-$BUILD.txz
